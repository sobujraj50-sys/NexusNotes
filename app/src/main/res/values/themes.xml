<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform theme used only while the process starts. On Android 12+ the
        system splash screen uses windowBackground and the launcher icon.
        All in-app styling comes from Compose (core/design/theme).
    -->
    <style name="Theme.NexusNotes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Home-screen widget note row. -->
    <style name="WidgetNoteRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
